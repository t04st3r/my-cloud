# Copy to .env and adjust. All values have safe local-dev defaults in settings.py,
# so a .env file is optional for the default docker-compose-dev.yaml workflow.

# Debug mode (True for local development, False in production)
DEBUG=True

# Secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-me

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection URL (postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Google OAuth (sign-in). Create an OAuth 2.0 "Web application" client in the
# Google Cloud console and add the authorized redirect URI:
#   http://localhost:8000/accounts/google/login/callback/   (dev)
#   https://<your-domain>/accounts/google/login/callback/   (prod)
# The "Sign in with Google" button only works once these are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Production / object storage (not needed for local dev) -------------------
# Comma-separated origins Django trusts for HTTPS POST (the deployed domain).
# CSRF_TRUSTED_ORIGINS=https://your-app.ondigitalocean.app
#
# Store uploaded/encrypted media in DigitalOcean Spaces instead of local disk.
# Leave USE_SPACES unset/False for local development (local filesystem).
# USE_SPACES=True
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=
# SPACES_BUCKET=my-cloud-media
# SPACES_REGION=fra1
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
