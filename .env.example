# Copy to .env and adjust. All values have safe local-dev defaults in settings.py,
# so a .env file is optional for the default docker-compose-dev.yaml workflow.

# Debug mode (True for local development, False in production)
DEBUG=True

# Secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-me

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection URL (postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
