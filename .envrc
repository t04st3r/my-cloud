# direnv: automatically activate the uv-managed virtualenv on entering this dir.
# Requires direnv (https://direnv.net) hooked into your shell. Run `direnv allow`
# once to trust this file.

# Re-run this file whenever the dependency spec changes.
watch_file pyproject.toml uv.lock

# Load variables from .env into the shell environment (if present). Django reads
# .env on its own via django-environ, so this is only for convenience with other
# tools. dotenv is a no-op when .env is absent.
[ -f .env ] && dotenv .env

# Create/refresh .venv from the lockfile (fast no-op when already in sync).
uv sync

# Activate the venv: exports VIRTUAL_ENV and prepends .venv/bin to PATH, which
# direnv captures and unloads again when you leave the directory.
# VIRTUAL_ENV_DISABLE_PROMPT stops the activate script from touching PS1
# (direnv can't export PS1 and would otherwise print a harmless warning).
export VIRTUAL_ENV_DISABLE_PROMPT=1
source .venv/bin/activate
